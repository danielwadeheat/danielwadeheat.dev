{
  "scripts": {
    "format": "prettier --write \"**/*.{css,js,json,md,mjs}\" .htmlhintrc && node scripts/normalize-html-style.mjs --write",
    "format:check": "prettier --check \"**/*.{css,js,json,md,mjs}\" .htmlhintrc && node scripts/normalize-html-style.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:html": "htmlhint \"*.html\"",
    "spell": "cspell .",
    "check": "npm run format:check && npm run lint && npm run lint:html && npm run spell",
    "prepare-hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "cspell": "^10.0.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "htmlhint": "^1.9.2",
    "prettier": "^3.9.1"
  }
}
